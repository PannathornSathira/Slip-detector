# Processing mode for OCR: 'lite' (EasyOCR) or 'local' (Typhoon OCR via Ollama)
PROCESSING_MODE=lite

# LLM Provider Configuration
# Choose 'local', 'gemini', 'openai' (or leave empty to use local rule-based heuristics only)
LLM_PROVIDER=local

# Local model names
LOCAL_VLM_MODEL=scb10x/typhoon-ocr-3b
LOCAL_LLM_MODEL=scb10x/llama3.1-typhoon2-8b-instruct

# API Key for Google Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# API Key for OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
